{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/carbocation/pgsc_mirror/main/docs/latest.schema.json",
  "title": "pgsc-mirror latest release pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id", "manifest_key", "manifest_sha256", "score_list_sha256",
    "metadata_sha256", "published_at", "entry_count", "genome_build", "score_layout_version"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "manifest_key": {"type": "string", "pattern": "^releases/.+/manifest\\.jsonl\\.gz$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score_list_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "entry_count": {"type": "integer", "minimum": 0},
    "genome_build": {"const": "GRCh38"},
    "score_layout_version": {"const": 1},
    "header_inspector_version": {"type": "integer", "minimum": 1}
  }
}
