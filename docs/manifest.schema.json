{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/carbocation/pgsc_mirror/main/docs/manifest.schema.json",
  "title": "pgsc-mirror manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id", "pgs_id", "genome_build", "source_url", "source_md5",
    "size_bytes", "blob_key", "first_seen_at", "last_seen_at", "status"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"},
    "pgs_id": {"type": "string", "pattern": "^PGS[0-9]{6}$"},
    "genome_build": {"const": "GRCh38"},
    "source_url": {"type": "string", "format": "uri"},
    "source_md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "blob_key": {"type": "string", "pattern": "^blobs/md5/[0-9a-f]{2}/[0-9a-f]{32}\\.txt\\.gz$"},
    "upstream_etag": {"type": "string"},
    "upstream_last_modified": {"type": "string"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["available", "withdrawn"]},
    "license": {"type": "string"},
    "gcs_generation": {"type": "integer", "minimum": 0},
    "header": {"$ref": "#/$defs/header_inspection"}
  },
  "$defs": {
    "header_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspector_version", "status", "type", "comment_lines"],
      "properties": {
        "inspector_version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["recognized", "unrecognized", "unreadable"]},
        "type": {
          "enum": [
            "pgs-catalog-harmonized-v2",
            "pgs-catalog-harmonized-versioned",
            "pgs-catalog-harmonized-unversioned",
            "pgs-catalog-formatted-v2",
            "pgs-catalog-formatted",
            "unknown"
          ]
        },
        "format_version": {"type": "string"},
        "delimiter": {"enum": ["tab", "comma", "whitespace"]},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "metadata_keys": {"type": "array", "items": {"type": "string"}},
        "sections": {"type": "array", "items": {"type": "string"}},
        "comment_lines": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "error": {"type": "string"}
      }
    }
  }
}
